# Postgres (en Railway: referencia ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5432/brawlstats

# api
PORT=4000
# Llave de developer.brawlstars.com ligada a las IPs fijas de la api (hito 2)
BRAWL_API_TOKEN=

# web: URL de la api (en Railway: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}})
API_URL=http://localhost:4000

# api (opcional): activa "Pedir opinión de IA" en el simulador de draft
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
